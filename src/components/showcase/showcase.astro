---
import styles from './showcase.module.css';

interface Badge {
	label: string;
	image: string;
	alt: string;
}

const badges: Badge[] = [
	{
		label: 'Sabores frutales',
		image: '/media/cinco-chiles.webp',
		alt: 'Botella de Holly Salsa Cinco Chiles',
	},
	{
		label: 'Ingredientes naturales',
		image: '/media/habanero.webp',
		alt: 'Botella de Holly Salsa Habanero',
	},
	{
		label: 'Favorita de muchos',
		image: '/media/mora-tamarindo.webp',
		alt: 'Botella de Holly Salsa Mora Tamarindo',
	},
	{
		label: 'Preparación Gourmet',
		image: '/media/asada.webp',
		alt: 'Botella de Holly Salsa Piña Asada',
	},
	{
		label: 'Realce de sabor',
		image: '/media/fresa-picante.webp',
		alt: 'Botella de Holly Salsa Fresa Picante',
	},
];
---

<section class={styles.showcase} aria-label="Galería y cualidades de Holly Salsa">
	<div class={styles.mediaGrid}>
		<figure class={`${styles.mediaItem} ${styles.itemPico}`}>
			<img
				src="/media/pico-de-gallo.jpg"
				alt="Totopos con pico de gallo y salsa roja"
				width="4000"
				height="6000"
				loading="lazy"
				decoding="async"
				class={styles.mediaAsset}
			/>
		</figure>

		<figure class={`${styles.mediaItem} ${styles.itemBotellas}`}>
			<img
				src="/media/botellas.jpg"
				alt="Lote artesanal de botellas de Holly Salsa"
				width="4032"
				height="3024"
				loading="lazy"
				decoding="async"
				class={styles.mediaAsset}
			/>
		</figure>

		<figure class={`${styles.mediaItem} ${styles.itemVideo}`}>
			<video
				src="/media/video-1.mp4"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				aria-label="Video de salsas Holly Salsa"
				class={styles.mediaAsset}
			/>
		</figure>

		<figure class={`${styles.mediaItem} ${styles.itemCarniceria}`}>
			<img
				src="/media/carniceria.jpg"
				alt="Botellas de Holly Salsa en mostrador de carnicería"
				width="1200"
				height="1200"
				loading="lazy"
				decoding="async"
				class={styles.mediaAsset}
			/>
		</figure>

		<figure class={`${styles.mediaItem} ${styles.itemChiles}`}>
			<img
				src="/media/chiles.jpg"
				alt="Chiles frescos, tomates y salsa artesanal"
				width="3456"
				height="5184"
				loading="lazy"
				decoding="async"
				class={styles.mediaAsset}
			/>
		</figure>

		<figure class={`${styles.mediaItem} ${styles.itemFlores}`}>
			<img
				src="/media/flores-frutas.jpg"
				alt="Frutas picadas, tomates y flores frescas"
				width="5464"
				height="8192"
				loading="lazy"
				decoding="async"
				class={styles.mediaAsset}
			/>
		</figure>
	</div>

	<div class={styles.badgesViewport}>
		<div class={styles.badgesTrack}>
			<ul class={styles.badgesList}>
				{
					badges.map((badge) => (
						<li class={styles.badge}>
							<img
								src={badge.image}
								alt={badge.alt}
								width="860"
								height="1828"
								loading="lazy"
								decoding="async"
								class={styles.badgeImage}
							/>
							<span class={styles.badgeText}>{badge.label}</span>
						</li>
					))
				}
			</ul>

			<ul class={`${styles.badgesList} ${styles.badgesClone}`} aria-hidden="true">
				{
					badges.map((badge) => (
						<li class={styles.badge}>
							<img
								src={badge.image}
								alt=""
								width="860"
								height="1828"
								loading="lazy"
								decoding="async"
								class={styles.badgeImage}
							/>
							<span class={styles.badgeText}>{badge.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

