---
import styles from './package.module.css';

interface StoryStep {
	text: string;
	side: 'left' | 'right';
}

const storySteps: StoryStep[] = [
	{
		text: 'Todas nuestras salsas en una presentación',
		side: 'left',
	},
	{
		text: 'Una caja diseñada para ofrecerte la mejor experiencia',
		side: 'right',
	},
	{
		text: 'Pensamos en ofrecerte un producto de calidad inigualable en un paquete que refleja nuestro amor por nuestro producto.',
		side: 'left',
	},
	{
		text: 'Tenemos respeto por el picante y por el sabor, nuestras salsas lo demuestran',
		side: 'right',
	},
	{
		text: 'Habanero, Cinco chiles, Piña asada, Fresa picante, Mora tamarindo y Mango habanero.',
		side: 'left',
	},
	{
		text: 'Adquiere tu paquete y conoce lo que creamos para ti.',
		side: 'right',
	},
];
---

<section
	class={styles.packageSection}
	aria-labelledby="package-section-title"
	data-package-section
>
	<div class={styles.stickyStage}>
		<div class={styles.waveBackdrop} aria-hidden="true">
			<svg
				class={`${styles.waveLayer} ${styles.waveBack}`}
				data-package-wave-back
				viewBox="0 0 2880 300"
				preserveAspectRatio="none"
				focusable="false"
			>
				<path d="M 0 92 C 60 74, 150 42, 240 42 C 365 42, 445 112, 580 112 C 725 112, 815 12, 980 12 C 1135 12, 1205 108, 1315 108 C 1350 108, 1380 110, 1440 92 C 1500 74, 1590 42, 1680 42 C 1805 42, 1885 112, 2020 112 C 2165 112, 2255 12, 2420 12 C 2575 12, 2645 108, 2755 108 C 2790 108, 2820 110, 2880 92 L 2880 302 L 0 302 Z" />
			</svg>
			<svg
				class={`${styles.waveLayer} ${styles.waveFront}`}
				data-package-wave-front
				viewBox="0 0 2880 300"
				preserveAspectRatio="none"
				focusable="false"
			>
				<path d="M 0 112 C 60 94, 110 66, 175 66 C 275 66, 365 132, 495 132 C 640 132, 725 34, 905 34 C 1085 34, 1175 128, 1300 128 C 1345 128, 1380 130, 1440 112 C 1500 94, 1550 66, 1615 66 C 1715 66, 1805 132, 1935 132 C 2080 132, 2165 34, 2345 34 C 2525 34, 2615 128, 2740 128 C 2785 128, 2820 130, 2880 112 L 2880 302 L 0 302 Z" />
			</svg>
		</div>

		<header class={styles.header}>
			<h2 id="package-section-title" class={styles.title}>
				Creamos un paquete para los amantes del picante
			</h2>
			<p class={styles.scrollHint} data-package-hint data-visible="true">
				Sigue bajando para descubrir el contenido <span aria-hidden="true">↓</span>
			</p>
		</header>

		<div class={styles.viewerFrame} data-package-viewer>
			<canvas
				class={styles.canvas}
				data-package-canvas
				role="img"
				aria-label="Modelo 3D de la caja de 6 salsas artesanales Holly Salsa que se abre al desplazarse"
			></canvas>

			<img
				src="/media/paquete-personal.png"
				alt="Paquete Holly Salsa con seis botellas de salsa artesanal en caja de regalo"
				loading="lazy"
				decoding="async"
				class={styles.fallbackImage}
			/>
		</div>

		<ol class={styles.storyList} aria-label="Características del paquete Holly Salsa">
			{
				storySteps.map((step, index) => (
					<li
						class={`${styles.storyItem} ${step.side === 'left' ? styles.storyLeft : styles.storyRight}`}
						data-story-step={index}
						data-state="before"
					>
						<p class={styles.storyText}>{step.text}</p>
					</li>
				))
			}
		</ol>

		<div class={styles.ctaWrap} data-package-cta data-visible="false">
			<a href="/products" class={styles.ctaButton}>
				Adquiere la tuya
			</a>
		</div>
	</div>
</section>

<script>
	const sections = document.querySelectorAll<HTMLElement>('[data-package-section]');
	const supportsScrollDrivenWaves =
		typeof CSS !== 'undefined' &&
		CSS.supports('(animation-timeline: view()) and (animation-range: entry)');

	for (const section of sections) {
		if (!supportsScrollDrivenWaves) {
			const frontWave = section.querySelector<SVGElement>('[data-package-wave-front]');
			const backWave = section.querySelector<SVGElement>('[data-package-wave-back]');
			if (frontWave && backWave) {
				import('./packageWaveFallback')
					.then(({ initPackageWaveFallback }) => {
						initPackageWaveFallback({ section, frontWave, backWave });
					})
					.catch(() => {});
			}
		}

		const viewerFrame = section.querySelector<HTMLElement>('[data-package-viewer]');
		const canvas = section.querySelector<HTMLCanvasElement>('[data-package-canvas]');
		const scrollHint = section.querySelector<HTMLElement>('[data-package-hint]');
		const ctaWrap = section.querySelector<HTMLElement>('[data-package-cta]');
		const storyItems = Array.from(
			section.querySelectorAll<HTMLElement>('[data-story-step]'),
		);

		if (!viewerFrame || !canvas) continue;

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				import('./packageViewer')
					.then(({ initPackageViewer }) => {
						initPackageViewer({
							section,
							viewerFrame,
							canvas,
							scrollHint,
							ctaWrap,
							storyItems,
						});
					})
					.catch(() => {
						viewerFrame.dataset.fallback = 'true';
						if (scrollHint) scrollHint.dataset.visible = 'false';
						if (ctaWrap) ctaWrap.dataset.visible = 'true';
					});
			},
			{ rootMargin: '600px 0px' },
		);

		observer.observe(section);
	}
</script>
