---
import styles from './resellers.module.css';

interface ReviewItem {
	id: string;
	src: string;
	width: number;
	height: number;
	label: string;
	alt: string;
}

const reviews: ReviewItem[] = [
	{
		id: 'review-1',
		src: '/media/review-1.webp',
		width: 610,
		height: 524,
		label: 'Reseña de La Andaluza en Santa Elena',
		alt: 'Captura de WhatsApp de La Andaluza en Santa Elena pidiendo más salsas porque les ha gustado mucho a sus clientes',
	},
	{
		id: 'review-2',
		src: '/media/review-2.webp',
		width: 738,
		height: 1336,
		label: 'Reseña de cliente en Toluca',
		alt: 'Captura de WhatsApp de un cliente en Toluca preguntando en qué otra tienda puede volver a comprar la salsa porque se le acabó',
	},
	{
		id: 'review-3',
		src: '/media/review-3.webp',
		width: 738,
		height: 1336,
		label: 'Reseña de pedido recurrente de caja de salsas',
		alt: 'Captura de WhatsApp de un negocio pidiendo otra caja de salsas repetidamente',
	},
	{
		id: 'review-4',
		src: '/media/review-4.webp',
		width: 738,
		height: 1336,
		label: 'Reseña de reabastecimiento frecuente',
		alt: 'Captura de WhatsApp de la señorita Martha solicitando más salsas repetidamente',
	},
	{
		id: 'review-5',
		src: '/media/review-5.webp',
		width: 3000,
		height: 4000,
		label: 'Fotografía de cliente en Cárnicos Chuy',
		alt: 'Fotografía de un distribuidor en Cárnicos Chuy sonriendo junto al exhibidor de botellas de Holly Salsa en su mostrador',
	},
];
---

<section
	class={styles.resellersSection}
	aria-labelledby="resellers-section-title"
	data-resellers-section
>
	<div class={styles.patternLayer} aria-hidden="true"></div>

	<div class={styles.stageColumn} data-resellers-stage>
		<div class={styles.reviewField} data-resellers-field>
			{
				reviews.map((review) => (
					<figure
						class={styles.reviewCard}
						style={`--card-aspect: ${review.width} / ${review.height}`}
						data-review-card
						data-review-id={review.id}
						data-review-label={review.label}
						data-aspect={String(review.width / review.height)}
					>
						<img
							src={review.src}
							alt={review.alt}
							width={review.width}
							height={review.height}
							loading="lazy"
							decoding="async"
							draggable="false"
							class={styles.reviewImage}
						/>
					</figure>
				))
			}
		</div>

		<div class={styles.srOnly} aria-live="polite" data-resellers-live></div>
	</div>

	<header class={styles.header}>
		<h2 id="resellers-section-title" class={styles.title}>
			Holly Salsa en tu negocio
		</h2>
		<p class={styles.dragHint} data-resellers-hint data-visible="false">
			Arrastra las reseñas
		</p>
	</header>

	<div class={styles.contentGrid}>
		<div class={styles.copyColumn}>
			<p class={styles.description}>
				El sabor de Holly Salsa se comparte y por ello contamos con el paquete especial para negocios.
			</p>
			<p class={styles.description}>
				Contamos con varios clientes en el centro del país que ya integran los productos de Holly Salsa en sus negocios.
			</p>
			<a href="/products" class={styles.ctaButton}>
				Adquiere el paquete de salsas para tu negocio
			</a>
		</div>
	</div>

	<dialog
		class={styles.reviewModal}
		{...({ closedby: 'any' } as Record<string, string>)}
		aria-label="Vista ampliada de la reseña"
		data-resellers-modal
	>
		<img
			alt=""
			decoding="async"
			draggable="false"
			class={styles.modalImage}
			data-resellers-modal-image
		/>
		<form method="dialog" class={styles.modalForm}>
			<button type="submit" class={styles.modalClose}>
				Cerrar reseña
			</button>
		</form>
	</dialog>
</section>

<script>
	import { initResellersModal } from './resellersModal';

	const sections = document.querySelectorAll<HTMLElement>('[data-resellers-section]');

	for (const section of sections) {
		const stage = section.querySelector<HTMLElement>('[data-resellers-stage]');
		const field = section.querySelector<HTMLElement>('[data-resellers-field]');
		const hint = section.querySelector<HTMLElement>('[data-resellers-hint]');
		const liveRegion = section.querySelector<HTMLElement>('[data-resellers-live]');
		const modal = section.querySelector<HTMLDialogElement>('[data-resellers-modal]');
		const modalImage = section.querySelector<HTMLImageElement>('[data-resellers-modal-image]');
		const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-review-card]'));

		if (!stage || !field || cards.length === 0) continue;

		const modalController =
			modal && modalImage
				? initResellersModal({
						dialog: modal,
						image: modalImage,
						cards,
					})
				: null;

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				import('./resellersRain')
					.then(({ initResellersRain }) => {
						initResellersRain({
							section,
							stage,
							field,
							hint,
							liveRegion,
							cards,
							onOpenReview: modalController
								? (card) => modalController.openCard(card, { defer: true })
								: undefined,
						});
					})
					.catch(() => {
						// Static collage remains visible and readable as fallback
					});
			},
			{ rootMargin: '600px 0px' },
		);

		observer.observe(section);
	}
</script>
